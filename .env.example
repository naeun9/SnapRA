# AI-Hub API 키 (마이페이지 > API 키 발급에서 확인)
# 실제 값은 .env 에 채우세요. .env 는 git 에 커밋되지 않습니다.
AIHUB_API_KEY=

# 건설현장 위험 상태 판단 데이터 (주력)
# scripts/download.sh list 로 목록을 받아 datasetkey 를 찾아 채우세요.
AIHUB_DATASETKEY_RISK=

# 공사현장 안전장비 인식 이미지 (보조)
AIHUB_DATASETKEY_EQUIP=163

# Gemini API 키 (https://aistudio.google.com/apikey)
# 무료 티어는 입력/출력이 Google 제품 개선에 사용된다. AI-Hub 공개 데이터셋 평가에는
# 무방하지만, 실제 현장 사진을 받는 서비스로 확장하면 유료 티어로 올려야 한다.
GEMINI_API_KEY=

# 사용 모델 (비우면 gemini-3.8-flash)
GEMINI_MODEL=
